# === Data files (too large for GitHub) ===
*.csv
*.nc
*.rds
*.RData
*.rda

# === R artifacts ===
.Rhistory
.Rproj.user/
*.Rproj
.Rdata

# === Python ===
__pycache__/
*.pyc
.env

# === OS files ===
.DS_Store
Thumbs.db

# === Output files (reproducible, not tracked) ===
outputs/figures/*.png
outputs/figures/*.pdf
outputs/tables/*.csv

# === But DO track these config/metadata files ===
!data/site_metadata/*.csv
!config/*.csv
